APP_NAME="Trendy Deal BD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local development: SQLite is the easiest option.
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# For local MySQL/MariaDB instead, comment SQLite above and use:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=trendydealbd_shop
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

ADMIN_NAME="Trendy Deal BD Admin"
ADMIN_EMAIL=admin@trendydealbd.shop
ADMIN_PASSWORD=ChangeMe123!
